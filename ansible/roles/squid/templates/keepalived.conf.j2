# {{ ansible_managed }}
global_defs {
  router_id {{ inventory_hostname }}
  script_user keepalived_script
  enable_script_security
}

vrrp_script check_squid {
  script "/usr/libexec/keepalived/check_squid"
  user keepalived_script
  interval 2
  timeout 1
  fall 2
  rise 2
  weight -60
}

{% for instance in proxy_keepalived_vrrp_instances %}
vrrp_instance {{ instance.name }} {
  interface {{ instance.interface }}
  state {{ "MASTER" if host_index == 1 else "BACKUP" }}
  virtual_router_id {{ instance.virtual_router_id }}
  priority {{ 150 if host_index == 1 else 100 }}
  advert_int 1
  garp_master_delay 1
  garp_master_repeat 5
  garp_master_refresh 60
  garp_master_refresh_repeat 2
  authentication {
    auth_type PASS
    # Keepalived auth_pass must be 8 characters or fewer.
    auth_pass {{ proxy_keepalived_password }}
  }
  virtual_ipaddress {
{% for vip in instance.virtual_ipaddresses %}
    {{ vip }}
{% endfor %}
  }
  track_script {
    check_squid
  }
}
{% endfor %}
